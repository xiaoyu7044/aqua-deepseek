{
  "name": "aqua-deepseek",
  "version": "2.0.0",
  "description": "DeepSeek API 实时价格鱼缸浮窗 — 一键装进 DeepSeek Harness (HD)，像素风陪伴式动画，自动跟随峰谷时段",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "tsc --esModuleInterop --skipLibCheck --module esnext --target es2022 --moduleResolution bundler --outDir . index.ts"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "pricing-widget",
    "pixel-fish",
    "aquarium",
    "realtime-pricing",
    "peak-offpeak",
    "aqua"
  ],
  "author": "LiJiaChuan (xiaoyu7044)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiaoyu7044/aqua-deepseek"
  },
  "files": [
    "index.js",
    "index.ts",
    "deepseek-price-widget.js",
    "cordis.patch.yml",
    "scripts/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  }
}
